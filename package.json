{
  "name": "wizytowka-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_execpath||'')){console.error('✖ Użyj pnpm');process.exit(1)}\"",
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm -r start",
    "start:prod": "corepack pnpm -F backend run start:prod",
    "prisma:generate": "corepack pnpm -F backend exec prisma generate --schema prisma/schema.prisma",
    "prelint": "corepack pnpm prisma:generate",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm test:unit && corepack pnpm test:bdd",
    "test:unit": "corepack pnpm -F backend test && corepack pnpm -F frontend test",
    "test:bdd": "corepack pnpm -F backend test:bdd",
    "test:e2e": "corepack pnpm test:e2e:backend && corepack pnpm test:e2e:frontend",
    "test:e2e:backend": "corepack pnpm -F backend test:e2e",
    "test:e2e:frontend": "corepack pnpm -F frontend test:e2e",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm build && corepack pnpm test:unit && corepack pnpm test:bdd && corepack pnpm test:e2e && echo '✅ Wszystkie sprawdzenia pomyślne!'",
    "test:all": "corepack pnpm check"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.10"
  },
  "pnpm": {
    "overrides": {
      "@ardatan/relay-compiler": "^13.0.2",
      "@babel/core": "^7.29.6",
      "@graphql-tools/relay-operation-optimizer": "^7.1.1",
      "@protobufjs/utf8": "^1.1.1",
      "@angular-devkit/core>ajv": "^8.18.0",
      "diff@^4.0.0": "^4.0.4",
      "body-parser": "^2.3.0",
      "brace-expansion@^1.0.0": "^1.1.16",
      "brace-expansion@^2.0.0": "^2.1.2",
      "brace-expansion@^5.0.0": "^5.0.8",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.4",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^5.7.0",
      "file-type": "^21.3.2",
      "flatted": "^3.4.2",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "handlebars": "^4.7.9",
      "hono": "^4.11.10",
      "immutable@^5.0.0": "^5.1.8",
      "js-yaml@^3.0.0": "^3.15.0",
      "js-yaml@^4.0.0": "^4.3.0",
      "lodash": "^4.18.0",
      "minimatch@^3.0.0": "^3.1.5",
      "minimatch@^9.0.0": "^9.0.8",
      "path-to-regexp@^8.0.0": "^8.4.0",
      "picomatch@^2.0.0": "^2.3.2",
      "picomatch@^4.0.0": "^4.0.4",
      "postcss": "^8.5.18",
      "qs": "^6.15.2",
      "serialize-javascript": "^7.0.5",
      "sharp": "^0.35.0",
      "shell-quote": "^1.9.0",
      "svix>uuid": "^11.1.1",
      "undici": "^7.28.0",
      "vite": "^8.0.16",
      "ws@^7.0.0": "^7.5.11",
      "ws@^8.0.0": "^8.21.0",
      "yaml": "^2.8.3",
      "yauzl": "^3.2.1"
    }
  }
}
