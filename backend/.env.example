# Copy this file to backend/.env and fill the values for your environment.
# Do not commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

MONGODB_URI=mongodb://localhost:27017/wizytowka
MONGODB_DB=wizytowka

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=portfolio@example.com
SMTP_TO=owner@example.com
SMTP_USER=
SMTP_PASS=
SMTP_DEBUG=false

ADMIN_TOKEN=<set-me>
OPENAI_API_KEY=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=<set-me>
