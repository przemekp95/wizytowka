# Copy this file to backend/.env and fill values for your environment.
# Do not commit real secrets. For AWS, prefer IAM role / AWS profile.
ADMIN_TOKEN=<set-me>
ALLOWED_ORIGINS=<set-me>
AWS_ACCESS_KEY_ID=
AWS_REGION=<set-me>
AWS_PROFILE=default
AWS_S3_BUCKET=<set-me>
AWS_S3_BUCKET_NAME=<set-me>
AWS_SECRET_ACCESS_KEY=
BCRYPT_ROUNDS=<set-me>
COOKIE_MAX_AGE=<set-me>
CORS_ORIGINS=<set-me>
DATABASE_URL=<set-me>
FRONTEND_URL=<set-me>
GRAPHQL_INTROSPECTION=<set-me>
GRAPHQL_PLAYGROUND=<set-me>
HCAPTCHA_SECRET=<set-me>
HCAPTCHA_SITE_KEY=<set-me>
LOG_LEVEL=<set-me>
MONGODB_DB=<set-me>
MONGODB_URI=<set-me>
MONGODB_URL=<set-me>
MONGO_URL=<set-me>
NODE_ENV=<set-me>
PORT=<set-me>
RENDER_EXTERNAL_URL=<set-me>
SESSION_SECRET=<set-me>
SMTP_DEBUG=<set-me>
SMTP_FROM=<set-me>
SMTP_HOST=<set-me>
SMTP_PASS=<set-me>
SMTP_PORT=<set-me>
SMTP_SECURE=<set-me>
SMTP_TO=<set-me>
SMTP_USER=<set-me>
THROTTLE_LIMIT=<set-me>
THROTTLE_TTL=<set-me>
