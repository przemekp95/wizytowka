// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model ContactMessage {
  id                         String   @id @default(cuid()) @map("_id")
  name                       String
  email                      String
  message                    String
  ip                         String?
  requestId                  String?
  notificationStatus         String   @default("pending")
  notificationAttempts       Int      @default(0)
  notificationNextAttemptAt  DateTime? @default(now())
  notificationLeaseExpiresAt DateTime?
  notificationLastError      String?
  notificationSubmittedAt    DateTime?
  notificationSentAt         DateTime?
  notificationMessageId      String?
  createdAt                  DateTime @default(now())

  @@map("contact_messages")
}

model ContactNotificationWebhookEvent {
  id                    String   @id @map("_id")
  provider              String
  eventType             String
  contactMessageId      String?
  notificationMessageId String?
  eventCreatedAt        DateTime
  receivedAt            DateTime @default(now())

  @@map("contact_notification_webhook_events")
}

model PortfolioItem {
  id        String   @id @default(cuid()) @map("_id")
  title     String
  titleEn   String?  @map("title_en")
  slug      String   @unique
  href      String?
  desc      String?
  descEn    String?  @map("desc_en")
  tags      String[]
  img       String?
  isLogo    Boolean? @map("isLogo")
  newTech   Boolean? @map("newTech")
  repoUrl   String?  @map("repoUrl")
  order     Int?
  status    String   @default("published")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("portfolio_items")
}
