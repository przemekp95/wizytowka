{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": "tsconfig.spec.json", "transpilation": true }
    ]
  },
  "setupFilesAfterEnv": ["<rootDir>/test-setup.ts"],
  "testTimeout": 30000
}
