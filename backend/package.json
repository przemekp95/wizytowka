{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test,scripts,features}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test,scripts,features}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "jest",
    "test:bdd": "cucumber-js --require-module ts-node/register/transpile-only --require-module tsconfig-paths/register --require 'features/step-definitions/**/*.ts' --format progress --format summary 'features/**/*.feature'",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:k8s-ingress": "jest --config ./test/jest-e2e.json test/graphql-contact-k8s-ingress.e2e-spec.ts --runInBand",
    "test:e2e:aws-alb": "tsx ./scripts/verify-aws-alb-shared-throttle.ts",
    "portfolio:pull": "tsx ./scripts/portfolio-sync.ts pull",
    "portfolio:push": "tsx ./scripts/portfolio-sync.ts push",
    "portfolio:push:prune": "tsx ./scripts/portfolio-sync.ts push --prune",
    "portfolio:seed": "tsx ./scripts/seed-portfolio.ts",
    "start:dev": "nest start --watch",
    "pretest": "prisma generate"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/lib-storage": "^3.1073.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/uuid": "^11.0.0",
    "botid": "^1.5.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "graphql": "^16.13.1",
    "helmet": "^8.2.0",
    "mongodb": "^6.20.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.3",
    "openai": "^6.44.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "9.6.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.27",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}
