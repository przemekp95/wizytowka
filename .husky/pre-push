#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔧 Auto-naprawa kodu przed push'em..."
echo "💡 Sprawdzanie i poprawa jakości kodu (można przerwać: Ctrl+C)"

# Auto-fix: napraw wszystko co się da
cd frontend && pnpm run format >/dev/null 2>&1 && echo "✅ Formatowanie poprawione" && cd ..
pnpm run lint:fix >/dev/null 2>&1 && echo "✅ Linting poprawiony"

# Ostateczne sprawdzenie (bez blokowania push'a)
echo ""
echo "🎯 Ostateczna walidacja kodu:"
pnpm -F frontend run lint && echo "✅ Wszystkie sprawdzenia pomyślne!" || echo "⚠️  Znaleziono problemy - push zostanie wykonany mimo to"

echo "🚀 Push gotowy do wykonania!"
