#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🛡️ Sprawdzanie jakości kodu przed push..."
echo "🔍 Sprawdzam ESLint..."

# Run ESLint checks
if pnpm -r lint 2>&1; then
  echo "✅ ESLint - OK"
else
  echo "⚠️ ESLint - ostrzeżenia znalezione (akceptowane)"
fi

echo ""
echo "🔍 Sprawdzam formatowanie..."

# Run prettier check and capture output for display
if pnpm --filter "*frontend*" prettier --check . 2>&1; then
  echo "✅ Formatowanie - OK"
else
  echo "⚠️ Formatowanie wymaga poprawy (akceptowane)"
fi

echo ""
echo "⚠️ Sprawdzania kodu zakończone (ostrzeżenia pozwalają na push)"
echo "💡 Push jest dozwolony - kontynuuję..."
